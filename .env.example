# Shared across portal, gateway-api, and gateway-ingest.
DATABASE_URL=postgres://gateway:gateway@localhost:5432/llm_gateway
REDIS_URL=redis://localhost:6379

# 32+ character secrets. Generate with: openssl rand -base64 48
JWT_SIGNING_SECRET=change-me-to-a-long-random-secret
API_ENCRYPT_KEY=change-me-to-another-long-secret

# Portal (Better Auth)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-better-auth-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
EMAIL_FROM=noreply@example.com

# Optional Google OAuth. Leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gateway API
PORT=8080
REQUEST_BODY_LIMIT_BYTES=1048576
UPSTREAM_TIMEOUT_MS=120000
CHILD_KEY_RATE_LIMIT_RPM=600
GATEWAY_CORS_ORIGINS=
REQUEST_LOG_CAPTURE_LEVEL=metadata
REQUEST_LOG_STREAM_MAXLEN=10000

# Ingest
REQUEST_LOG_CONSUMER_GROUP=gateway-ingest
REQUEST_LOG_READ_COUNT=20
REQUEST_LOG_BLOCK_MS=5000
REQUEST_LOG_CLAIM_MIN_IDLE_MS=60000
