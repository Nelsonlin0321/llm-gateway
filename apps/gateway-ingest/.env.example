# Secrets — required. `wrangler dev` loads this file automatically.
# Do not commit real values. Production: `wrangler secret put <NAME>`.

DATABASE_URL=

# Upstash Redis TCP URL (rediss://default:TOKEN@<host>:6379).
# The Worker derives the REST URL/token from this for Cloudflare.
REDIS_URL=

# Optional: set these instead of (or in addition to) REDIS_URL.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Non-secret overrides (also in wrangler.jsonc vars).
# REQUEST_LOG_STREAM=llm-gateway-request-logs
# REQUEST_LOG_CONSUMER_GROUP=gateway-ingest
# REQUEST_LOG_CONSUMER_NAME=gateway-ingest-worker
# REQUEST_LOG_READ_COUNT=20
# REQUEST_LOG_BLOCK_MS=0
# REQUEST_LOG_CLAIM_MIN_IDLE_MS=60000
# REQUEST_LOG_IDLE_EXIT_MS=30000
# REQUEST_LOG_MAX_DURATION_MS=25000
# REQUEST_LOG_DEBUG=1
