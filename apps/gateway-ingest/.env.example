# Redis connection (required)
REDIS_URL=redis://127.0.0.1:6379

# Stream published by gateway-api (XADD)
REQUEST_LOG_STREAM=llm-gateway-request-logs

# Consumer group settings
# Phase A read path (Redis 6.2+ / 8.2 compatible):
#   1) XAUTOCLAIM <stream> <group> <consumer> <min-idle> 0-0 COUNT <n>
#   2) XREADGROUP GROUP <group> <consumer> COUNT <remaining> BLOCK <ms> STREAMS <stream> >
#   3) XACK <stream> <group> <id…> after successful extract+log
REQUEST_LOG_CONSUMER_GROUP=gateway-ingest
REQUEST_LOG_CONSUMER_NAME=consumer-1
REQUEST_LOG_READ_COUNT=100
REQUEST_LOG_BLOCK_MS=2000
# Min idle ms before reclaiming pending entries via XAUTOCLAIM (0 = skip reclaim)
REQUEST_LOG_CLAIM_MIN_IDLE_MS=60000
