{
  "name": "gateway-ingest",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "tsc --noEmit",
    "start": "bun run src/index.ts",
    "test": "bun test tests",
    "seed:event-log": "bun run scripts/seed-event-log/seed.ts",
    "seed:event-log:json": "bun run scripts/seed-event-log/seed.ts --dry-run --write-json=scripts/data/event-log-mock.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}