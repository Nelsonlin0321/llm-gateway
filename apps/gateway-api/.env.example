# Secrets — required. `wrangler dev` loads this file automatically.
# Do not commit real values. Production: `wrangler secret put <NAME>`.

DATABASE_URL=
JWT_SIGNING_SECRET=
API_ENCRYPT_KEY=

# Upstash Redis TCP URL (rediss://default:TOKEN@<host>:6379).
# The Worker derives the REST URL/token from this for Cloudflare.
REDIS_URL=

# Optional: set these instead of (or in addition to) REDIS_URL.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
